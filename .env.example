# Configuração do servidor
PORT=3000
NODE_ENV=development

# Banco de dados
# Em produção, a variável abaixo será preenchida com a URL do banco PostgreSQL do Render
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Autenticação JWT
JWT_SECRET=sua_chave_secreta_aqui

# Usuário Master (opcional - para criar usuário admin inicial)
MASTER_EMAIL=master@padaria.com
MASTER_PASSWORD=master123
