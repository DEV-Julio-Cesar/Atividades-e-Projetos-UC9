# -----------------------------------------------
# Variáveis de ambiente — copie para .env local
# No Render, configure estas variáveis no painel
# -----------------------------------------------

# Porta do servidor (o Render define PORT automaticamente)
EXPRESS_PORT=3000
EXPRESS_HOST=0.0.0.0

# Ambiente (development | production)
NODE_ENV=production

# Segredo da sessão (use uma string longa e aleatória em produção)
SESSION_SECRET=troque-por-uma-string-segura

# Caminho do banco SQLite (opcional — padrão: src/database/restaurante.sqlite)
# DB_PATH=/caminho/customizado/restaurante.sqlite

# Usuário master (criado automaticamente na primeira execução)
MASTER_EMAIL=master@padaria.com
MASTER_PASSWORD=troque-por-senha-forte
