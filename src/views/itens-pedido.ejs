<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Itens do Pedido — Padaria Pão Saboroso</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

<section class="page-header">
  <div>
    <p class="eyebrow">🥐 Padaria Pão Saboroso</p>
    <h2>Itens do Pedido</h2>
    <p>Adicione ou remova produtos de uma comanda.</p>
  </div>
  <div class="hero__actions">
    <a class="button" href="/painel">Painel</a>
    <a class="button" href="/painel/clientes">Clientes</a>
    <a class="button" href="/painel/pratos">Produtos</a>
    <a class="button" href="/painel/pedidos">Pedidos</a>
    <a class="button button--ghost" href="/status">Status</a>
  </div>
</section>

<% if (feedback) { %>
  <section class="feedback feedback--<%= feedback.tipo %>"><%= feedback.mensagem %></section>
<% } %>

<section class="form-card">
  <div class="panel-card__header">
    <div>
      <p class="eyebrow">Adicionar item</p>
      <h3>Inserir produto na comanda</h3>
    </div>
  </div>

  <form class="form-grid form-grid--three" action="/painel/itens-pedido" method="post">
    <label>
      <span>Comanda (Pedido)</span>
      <select name="idPedido" required>
        <option value="">Selecione uma comanda</option>
        <% pedidos.forEach((pedido) => { %>
          <option value="<%= pedido.id %>">Comanda <%= pedido.mesa %> — <%= pedido.cliente?.nome || 'Sem cliente' %></option>
        <% }) %>
      </select>
    </label>

    <label>
      <span>Produto</span>
      <select name="idPrato" required>
        <option value="">Selecione um produto</option>
        <% pratos.forEach((prato) => { %>
          <option value="<%= prato.id %>"><%= prato.nome %> — R$ <%= Number(prato.preco).toFixed(2) %></option>
        <% }) %>
      </select>
    </label>

    <label>
      <span>Quantidade</span>
      <input type="number" min="1" name="quantidade" placeholder="1" required>
    </label>

    <div class="form-actions">
      <button class="button" type="submit">Adicionar item</button>
    </div>
  </form>
</section>

<section class="table-card">
  <% if (itensPedido.length === 0) { %>
    <p class="empty-state">Nenhum item de pedido registrado ainda.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Qtd.</th>
            <th>Comanda</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% itensPedido.forEach((item) => { %>
            <tr>
              <td><strong><%= item.prato?.nome || 'Produto não encontrado' %></strong></td>
              <td><%= item.quantidade %></td>
              <td>Comanda <%= item.pedido?.mesa ?? '—' %></td>
              <td class="actions">
                <button class="button button--small"
                  onclick="editarItem('<%= item.id %>', '<%= item.quantidade %>')">Editar</button>
                <button class="button button--small button--danger"
                  onclick="confirmarDelecao('/itens-pedido/<%= item.id %>', 'item')">Deletar</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<script>
function confirmarDelecao(url, tipo) {
  if (!confirm(`Deseja deletar este ${tipo}?`)) return;
  fetch(url, { method: 'DELETE' })
    .then(res => { if (!res.ok) throw new Error('Erro'); return res.json(); })
    .then(() => { alert('Deletado com sucesso!'); location.reload(); })
    .catch(err => alert('Erro: ' + err.message));
}

function editarItem(id, quantidade) {
  const novaQtd = prompt('Nova quantidade:', quantidade);
  if (novaQtd === null) return;

  fetch(`/itens-pedido/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ quantidade: parseInt(novaQtd) })
  })
    .then(res => { if (!res.ok) throw new Error('Erro'); return res.json(); })
    .then(() => { alert('Item atualizado!'); location.reload(); })
    .catch(err => alert('Erro: ' + err.message));
}
</script>

</body>
</html>
