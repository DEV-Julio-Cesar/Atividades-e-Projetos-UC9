<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Padaria Pão Saboroso — Cadastro de Funcionário</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <style>
        body { display: grid; place-items: center; min-height: 100vh; padding: 24px; }
        .cadastro-card {
            width: min(520px, 100%);
            padding: 40px;
            border-radius: 32px;
            background: rgba(255, 253, 248, 0.88);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
        }
        .cadastro-card h1 { font-family: 'Fraunces', serif; font-size: 2rem; margin: 8px 0 4px; }
        .cadastro-card > p { color: var(--text-light); margin: 0 0 28px; }
        .cadastro-card label { display: grid; gap: 6px; font-weight: 700; color: var(--text); margin-bottom: 16px; }
        .cadastro-card input, .cadastro-card select {
            width: 100%; border: 2px solid var(--line); border-radius: 14px;
            padding: 12px 14px; background: rgba(255,255,255,0.82);
            color: var(--text); font: inherit; transition: all 0.3s ease;
        }
        .cadastro-card input:focus, .cadastro-card select:focus { 
            outline: none; border-color: var(--primary); 
            box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
        }
        .cadastro-card .button { width: 100%; padding: 14px; border-radius: 14px; font-size: 1rem; margin-top: 8px; }
        .back-link { 
            display: inline-flex; align-items: center; gap: 8px;
            text-align: center; margin-top: 16px; font-size: 0.88rem; 
            color: var(--primary); font-weight: 700; 
            padding: 10px 20px; border-radius: 50px;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        .back-link:hover {
            border-color: var(--primary);
            background: rgba(255, 107, 53, 0.1);
            transform: translateX(-5px);
        }
    </style>
</head>
<body>
    <div class="cadastro-card">
        <p class="eyebrow">🥐 Padaria Pão Saboroso</p>
        <h1>Cadastrar Funcionário</h1>
        <p>Preencha os dados para criar uma nova conta de acesso.</p>

        <form action="/User" method="post">
            <label for="username">
                Nome completo
                <input type="text" id="username" name="username" placeholder="Ex.: Maria Oliveira" required>
            </label>

            <label for="email">
                E-mail
                <input type="email" id="email" name="email" placeholder="seu@email.com" required>
            </label>

            <label for="perfil">
                Perfil de acesso
                <select id="perfil" name="perfil" required>
                    <option value="">Selecione o perfil</option>
                    <option value="admin">Administrador</option>
                    <option value="cliente">Atendente/Funcionário</option>
                </select>
            </label>

            <label for="password">
                Senha
                <input type="password" id="password" name="password" placeholder="••••••••" required>
            </label>

            <label for="confirmPassword">
                Confirmar senha
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
            </label>

            <button class="button" type="submit">➕ Cadastrar Funcionário</button>
        </form>

        <a class="back-link" href="/painel">
            <span>←</span>
            <span>Voltar ao Painel</span>
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
