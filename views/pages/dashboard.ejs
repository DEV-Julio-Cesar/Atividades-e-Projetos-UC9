<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Padaria Pão Saboroso</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPath: '/painel', usuario: usuario }) %>
    
    <main class="main-content">
      <div class="page-header-simple">
        <p class="eyebrow">🥐 Padaria Pão Saboroso</p>
        <h2>Olá<%= usuario?.nome ? `, ${usuario.nome}` : '' %> 👋</h2>
        <p>Acompanhe o movimento da padaria em tempo real</p>
      </div>

      <section class="stats-grid">
        <article class="stat-card">
          <p class="stat-card__label">Clientes</p>
          <h3><%= resumo.clientes %></h3>
        </article>
        <article class="stat-card">
          <p class="stat-card__label">Produtos</p>
          <h3><%= resumo.pratos %></h3>
        </article>
        <article class="stat-card">
          <p class="stat-card__label">Pedidos</p>
          <h3><%= resumo.pedidos %></h3>
        </article>
        <article class="stat-card">
          <p class="stat-card__label">Itens em pedidos</p>
          <h3><%= resumo.itensPedido %></h3>
        </article>
      </section>

      <section class="panel-grid">
        <article class="panel-card">
          <div class="panel-card__header">
            <h3>Pedidos recentes</h3>
            <a href="/painel/pedidos" class="button button--small">Ver todos</a>
          </div>

          <% if (pedidosRecentes.length === 0) { %>
            <p class="empty-state">Nenhum pedido registrado ainda.</p>
          <% } else { %>
            <div class="stack-list">
              <% pedidosRecentes.forEach((pedido) => { %>
                <div class="stack-item">
                  <div>
                    <strong>Comanda <%= pedido.mesa %></strong>
                    <p><%= pedido.cliente?.nome || 'Sem cliente vinculado' %></p>
                  </div>
                  <span class="chip"><%= pedido.status || 'aberto' %></span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </article>

        <article class="panel-card">
          <div class="panel-card__header">
            <h3>Produtos em destaque</h3>
            <a href="/painel/pratos" class="button button--small">Ver cardápio</a>
          </div>

          <% if (pratosDestaque.length === 0) { %>
            <p class="empty-state">Nenhum produto cadastrado ainda.</p>
          <% } else { %>
            <div class="stack-list">
              <% pratosDestaque.forEach((prato) => { %>
                <div class="stack-item">
                  <div>
                    <strong><%= prato.nome %></strong>
                    <p><%= prato.categoria || 'Sem categoria' %></p>
                  </div>
                  <span class="price-tag">R$ <%= Number(prato.preco).toFixed(2) %></span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </article>
      </section>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Prevenir cache ao usar botão voltar do navegador
    window.addEventListener('pageshow', function(event) {
      if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
        // Página carregada do cache (botão voltar)
        // Verificar se o usuário ainda está autenticado
        window.location.reload();
      }
    });
    
    // Prevenir cache
    if (window.history && window.history.pushState) {
      window.history.pushState('forward', null, '');
      window.addEventListener('popstate', function() {
        window.location.href = '/login';
      });
    }
  </script>
</body>
</html>
